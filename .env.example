# Supabase bulut veri erişimi (frontend — Vercel'de Environment Variables olarak tanımlayın)
# anon anahtarı halka açık istemci anahtarıdır; service_role anahtarını ASLA buraya koymayın.
VITE_SUPABASE_URL=https://ubymakwzxoutgqdeokje.supabase.co
VITE_SUPABASE_ANON_KEY=buraya-anon-public-anahtari

# Sunucu/GitHub Actions (frontend'e VITE_ önekiyle ASLA koymayın)
SUPABASE_URL=https://ubymakwzxoutgqdeokje.supabase.co
SUPABASE_SERVICE_ROLE_KEY=buraya-service-role-anahtari
ANTHROPIC_API_KEY=buraya-anthropic-anahtari

# SEC EDGAR otomatik erişiminde kurum/ürün adı ve iletişim adresi zorunludur.
SEC_USER_AGENT=PortfoyAI/1.0 iletisim@alanadiniz.com

# Claude maliyet korumaları
AI_DAILY_BUDGET_USD=1.00
AI_CACHE_TTL_DAYS=14
PORTFOLIO_AI_DAILY_LIMIT=5
PORTFOLIO_AI_CACHE_HOURS=6
PORTFOLIO_AI_COOLDOWN_SECONDS=300

# Yalnızca gecikmeye dayanıklı 6 saatlik aday turunda etkinleştirin.
ANTHROPIC_USE_BATCH=false

# Kanıt kapısı eşiği (0-100). Boş bırakılırsa 78 kullanılır.
# Fırsatlar listesi sürekli boşsa düşürün, çok doluysa yükseltin —
# kod değişikliği/deploy gerekmez. Sunucu ve frontend aynı değeri almalıdır.
CONVICTION_THRESHOLD=78
VITE_CONVICTION_THRESHOLD=78

# Demo verileri production'da varsayılan olarak kapalıdır.
VITE_ENABLE_MOCK_DATA=false
