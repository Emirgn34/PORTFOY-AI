{
  "functions": { "api/account.js": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/api/news/scan", "destination": "/api/account?feature=news-scan" },
    { "source": "/api/hedge-radar", "destination": "/api/account?feature=hedge&action=state" },
    { "source": "/api/hedge-radar/refresh", "destination": "/api/account?feature=hedge&action=refresh" },
    { "source": "/api/notifications/subscribe", "destination": "/api/account?feature=automation&action=push" },
    { "source": "/api/notifications/trigger", "destination": "/api/account?feature=hedge&action=trigger" },
    { "source": "/manifest.json", "destination": "/manifest.webmanifest" },
    { "source": "/((?!api/|sw\\.js$|manifest\\.webmanifest$).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
      { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
    ] },
    { "source": "/manifest.webmanifest", "headers": [
      { "key": "Content-Type", "value": "application/manifest+json" }
    ] }
  ]
}
